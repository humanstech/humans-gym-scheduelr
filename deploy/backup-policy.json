{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET/gym/*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["gym/*"]}}
    }
  ]
}
